server:
  host: 0.0.0.0
  port: 8080

theme:
  background-color: 225 14 15
  primary-color: 220 75 65
  contrast-multiplier: 1.1

pages:
  - name: My Day
    columns:
      - size: small
        widgets:
          - type: clock
            hour-format: 12h
            timezones:
              - timezone: @@TIMEZONE@@
                label: Home

          - type: weather
            units: imperial
            hour-format: 12h
            location: "@@WEATHER_LOCATION@@"

          - type: calendar
            first-day-of-week: sunday

      - size: full
        widgets:
          - type: custom-api
            title: Agenda
            cache: 1m
            url: http://127.0.0.1:8082/agenda
            template: |
              {{ if ne .Response.StatusCode 200 }}
                <p class="color-negative">The digest service returned {{ .Response.StatusCode }}.</p>
                <p class="size-h5 color-paragraph">Check the add-on log for details.</p>
              {{ else if eq (.JSON.String "summary.headline") "No accounts configured" }}
                <p class="size-h4 color-highlight">No calendar connected yet.</p>
                <p class="size-h5 color-paragraph margin-top-15">
                  Run <code>scripts/authorize-google.py</code> for the personal Gmail account and
                  <code>scripts/authorize-microsoft.py</code> for work Outlook, then paste the
                  refresh tokens into this add-on's options.
                </p>
              {{ else }}
                <p class="size-h3 color-highlight text-truncate">{{ .JSON.String "summary.headline" }}</p>
                <ul class="list-horizontal-text">
                  <li>{{ .JSON.Int "summary.today_count" }} today</li>
                  <li>{{ .JSON.Int "summary.tomorrow_count" }} tomorrow</li>
                </ul>

                {{ if .JSON.Bool "stale" }}
                  <p class="size-h6 color-negative margin-top-15">
                    Cached data &mdash; the last refresh failed.
                  </p>
                {{ end }}
                {{ range .JSON.Array "errors" }}
                  <p class="size-h6 color-negative">{{ .String "label" }} calendar unavailable.</p>
                {{ end }}

                {{ if eq (len (.JSON.Array "groups")) 0 }}
                  <p class="color-positive margin-top-15">Nothing scheduled. Enjoy it.</p>
                {{ end }}

                {{ range .JSON.Array "groups" }}
                  <p class="size-h6 color-paragraph margin-top-15">{{ .String "label" }}</p>
                  <ul class="list list-gap-10 collapsible-container" data-collapse-after="6">
                    {{ range .Array "events" }}
                      <li>
                        <div class="flex justify-between">
                          {{ if .String "url" }}
                            <a class="size-h4 color-primary-if-not-visited text-truncate" href="{{ .String "url" }}" target="_blank" rel="noreferrer">{{ .String "summary" }}</a>
                          {{ else }}
                            <span class="size-h4 text-truncate">{{ .String "summary" }}</span>
                          {{ end }}
                          <span class="size-h6 color-paragraph">{{ .String "source_label" }}</span>
                        </div>
                        <ul class="list-horizontal-text">
                          {{ if .Bool "all_day" }}
                            <li>{{ .String "time_label" }}</li>
                          {{ else if .Bool "in_progress" }}
                            <li class="color-positive">Now</li>
                          {{ else }}
                            <li class="color-highlight">{{ .String "time_label" }}</li>
                          {{ end }}
                          {{ if .String "duration_label" }}<li>{{ .String "duration_label" }}</li>{{ end }}
                          {{ if .String "location" }}<li class="text-truncate">{{ .String "location" }}</li>{{ end }}
                        </ul>
                      </li>
                    {{ end }}
                  </ul>
                {{ end }}
              {{ end }}

          - type: custom-api
            title: Today's Tasks
            cache: 1m
            url: http://127.0.0.1:3456/api/v1/tasks?sort_by=due_date&order_by=asc&per_page=25&filter=done=false
            headers:
              Authorization: Bearer ${VIKUNJA_TOKEN}
            template: |
              {{ if eq .Response.StatusCode 200 }}
                {{ $tasks := .JSON.Array "" }}
                {{ if eq (len $tasks) 0 }}
                  <p class="color-positive">Nothing due. You're clear.</p>
                {{ else }}
                  <ul class="list list-gap-10 collapsible-container" data-collapse-after="8">
                  {{ range $tasks }}
                    <li>
                      <a class="size-h4 color-primary-if-not-visited" href="@@VIKUNJA_PUBLIC_URL@@tasks/{{ .Int "id" }}" target="_blank" rel="noreferrer">{{ .String "title" }}</a>
                      <ul class="list-horizontal-text">
                        {{ $p := .Int "priority" }}
                        {{ if ge $p 4 }}<li class="color-negative">High</li>
                        {{ else if eq $p 3 }}<li class="color-highlight">Medium</li>
                        {{ end }}
                        {{ $due := .String "due_date" }}
                        {{ if and $due (ne $due "0001-01-01T00:00:00Z") }}
                          <li {{ $due | parseRelativeTime "rfc3339" }}></li>
                        {{ end }}
                        {{ range .Array "labels" }}
                          <li style="color: #{{ .String "hex_color" }}">{{ .String "title" }}</li>
                        {{ end }}
                      </ul>
                    </li>
                  {{ end }}
                  </ul>
                {{ end }}
              {{ else if eq .Response.StatusCode 401 }}
                <p class="color-negative">Vikunja rejected the API token.</p>
                <p class="size-h5">Open Vikunja, create a token with read access to Tasks, then paste it into this add-on's "vikunja_token" option and restart.</p>
              {{ else }}
                <p class="color-negative">Vikunja returned {{ .Response.StatusCode }}.</p>
                <p class="size-h5">Check the add-on log for details.</p>
              {{ end }}

          - type: custom-api
            title: Inbox
            cache: 1m
            url: http://127.0.0.1:8082/mail
            template: |
              {{ if ne .Response.StatusCode 200 }}
                <p class="color-negative">The digest service returned {{ .Response.StatusCode }}.</p>
              {{ else if eq (.JSON.String "summary.headline") "No accounts configured" }}
                <p class="size-h4 color-highlight">No mailbox connected yet.</p>
                <p class="size-h5 color-paragraph margin-top-15">
                  The same two authorisation scripts cover mail as well as calendar &mdash;
                  Gmail needs <code>gmail.readonly</code> and Outlook needs <code>Mail.Read</code>.
                </p>
              {{ else }}
                <p class="size-h3 color-highlight">{{ .JSON.String "summary.headline" }}</p>
                <ul class="list-horizontal-text">
                  {{ range .JSON.Array "summary.by_account" }}
                    <li>{{ .String "label" }} {{ .Int "unread" }}</li>
                  {{ end }}
                </ul>

                {{ if .JSON.Bool "stale" }}
                  <p class="size-h6 color-negative margin-top-15">
                    Cached data &mdash; the last refresh failed.
                  </p>
                {{ end }}
                {{ range .JSON.Array "errors" }}
                  <p class="size-h6 color-negative">{{ .String "label" }} mailbox unavailable.</p>
                {{ end }}

                {{ if eq (len (.JSON.Array "messages")) 0 }}
                  <p class="color-positive margin-top-15">Nothing unread.</p>
                {{ else }}
                  <ul class="list list-gap-10 collapsible-container margin-top-15" data-collapse-after="5">
                    {{ range .JSON.Array "messages" }}
                      <li>
                        <div class="flex justify-between">
                          <a class="size-h4 color-primary-if-not-visited text-truncate" href="{{ .String "url" }}" target="_blank" rel="noreferrer">{{ .String "subject" }}</a>
                          <span class="size-h6 color-paragraph">{{ .String "source_label" }}</span>
                        </div>
                        <ul class="list-horizontal-text">
                          <li class="text-truncate">{{ .String "from_name" }}</li>
                          <li>{{ .String "time_label" }}</li>
                          {{ if .Bool "important" }}<li class="color-negative">Important</li>{{ end }}
                        </ul>
                        {{ if .String "snippet" }}<p class="size-h6 color-paragraph text-truncate">{{ .String "snippet" }}</p>{{ end }}
                      </li>
                    {{ end }}
                  </ul>
                {{ end }}
              {{ end }}

          - type: rss
            title: News
            style: detailed-list
            limit: 12
            collapse-after: 5
            cache: 30m
            feeds:
@@RSS_FEEDS@@

      - size: small
        widgets:
          - type: bookmarks
            groups:
              - title: My Stuff
                links:
                  - title: Vikunja (all tasks)
                    url: "@@VIKUNJA_PUBLIC_URL@@"
                  - title: Home Assistant
                    url: "@@HOME_ASSISTANT_URL@@"
              - title: Daily
                links:
                  - title: Gmail
                    url: https://mail.google.com/
                  - title: Google Calendar
                    url: https://calendar.google.com/
                  - title: Outlook (work)
                    url: https://outlook.office.com/mail/
                  - title: Outlook Calendar
                    url: https://outlook.office.com/calendar/

          - type: monitor
            cache: 5m
            title: Services
            sites:
              - title: Vikunja
                url: http://127.0.0.1:3456/
                icon: si:todoist
              - title: Calendar & mail digest
                url: http://127.0.0.1:8082/health
                icon: si:maildotru
              - title: Home Assistant
                url: "@@HOME_ASSISTANT_URL@@"
                icon: si:homeassistant
